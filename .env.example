OPENAI_API_KEY=your_api_key_here
MODEL_NAME=gpt-4-turbo
TEMPERATURE=0.7
SEED=42

# M7 — optional overrides for YAML config directory (defaults to <repo>/config)
# ARTICLEBOOK_CONFIG_DIR=C:\path\to\custom\config

# M7 — LLM provider label + timeout (seconds) for CrewAI / LiteLLM
# ARTICLEBOOK_LLM_PROVIDER=openai
# ARTICLEBOOK_LLM_TIMEOUT_S=120

# M7 — gatekeeper (retries / soft spacing between calls)
# ARTICLEBOOK_GK_RETRY_MAX=4
# ARTICLEBOOK_GK_MIN_INTERVAL_S=0

# M7 — RAG flag (reserved for M9-OPT; YAML `rag.enabled` is primary)
# ARTICLEBOOK_RAG_ENABLED=false

# LaTeX engine for M5 multipass driver: lualatex (default) or xelatex
# ARTICLEBOOK_LATEX_ENGINE=lualatex
