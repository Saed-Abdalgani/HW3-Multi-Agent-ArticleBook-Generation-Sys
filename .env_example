# Copy this file to ".env" in the repo root (same folder as pyproject.toml).
# PowerShell:  Copy-Item .env_example .env
#
# Fill in ONLY the three lines under "Your keys" — the part AFTER each prefix
# (sk-or-v1-  |  gsk_  |  nvapi-). If you already paste a full key including the
# prefix, that is OK too.
#
# Models default to Groq (70B) → OpenRouter → Groq (Llama 4 Scout backup; higher TPM than 8B Instant for large prompts). API keys are chosen from each
# model id prefix (groq/ openrouter/ nvidia_nim/). Override with:
# ARTICLEBOOK_ROUTE_MODELS=groq/...;openrouter/...;groq/...
# Optional: lower completion cap so OpenRouter prepaid accounts don't fail at ~16k reserved tokens:
# ARTICLEBOOK_LLM_MAX_TOKENS=4096

TEMPERATURE=0.7
SEED=42

# Optional: post-crew Markdown trim (default 1000; clamped 200–5000) to align with 750–1000 word chapters and M6 PDF page band 15–20.
# ARTICLEBOOK_MAX_WORDS_PER_CHAPTER=1000

# --- Your keys (all three required for the triple-route shortcut) ---
ARTICLEBOOK_GROQ_KEY_SUFFIX=
ARTICLEBOOK_OPENROUTER_KEY_SUFFIX=
ARTICLEBOOK_NVIDIA_KEY_SUFFIX=
