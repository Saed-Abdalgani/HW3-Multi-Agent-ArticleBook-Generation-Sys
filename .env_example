# Copy this file to ".env" in the repo root (same folder as pyproject.toml).
# PowerShell:  Copy-Item .env_example .env
#
# =============================================================================
# Recommended: OpenAI GPT-5.5 (Chat Completions / agentic crews)
# =============================================================================
# Model id: gpt-5.5 (see https://developers.openai.com/api/docs/models/gpt-5.5 ).
# Use a current LiteLLM (see pyproject.toml / uv.lock) for Day-0 routing.
#
# Completion budget: same number as ``max_tokens`` in ``config/models.yaml`` (**27768**).
# README “Token budget (exactly three lines)” explains the estimate vs. long LaTeX.
ARTICLEBOOK_LLM_PROVIDER=openai
OPENAI_API_KEY=

MODEL_NAME=gpt-5.5

TEMPERATURE=0.7
SEED=42

# Must match or exceed ``max_tokens`` in config/models.yaml unless you set this explicitly.
ARTICLEBOOK_LLM_MAX_TOKENS=27768

# Optional: wall-clock for long tool + reasoning calls (YAML default 300s when unset override).
# ARTICLEBOOK_LLM_TIMEOUT_S=300

# Optional: post-crew Markdown trim (default 1000; clamped 200–5000).
# ARTICLEBOOK_MAX_WORDS_PER_CHAPTER=1000

# =============================================================================
# Alternative: Google Gemini 3.5 Flash (AI Studio key, LiteLLM ``gemini/...``)
# =============================================================================
# ARTICLEBOOK_LLM_PROVIDER=google
# GEMINI_API_KEY=
# MODEL_NAME=gemini/gemini-3.5-flash
# # For Gemini, 65k output cap is model-side; you can lower ARTICLEBOOK_LLM_MAX_TOKENS.

# =============================================================================
# Alternative: multi-route shortcut (Groq + OpenRouter + NVIDIA)
# =============================================================================
# ARTICLEBOOK_LLM_PROVIDER=openai
# ARTICLEBOOK_GROQ_KEY_SUFFIX=
# ARTICLEBOOK_OPENROUTER_KEY_SUFFIX=
# ARTICLEBOOK_NVIDIA_KEY_SUFFIX=
# ARTICLEBOOK_ROUTE_MODELS=groq/...;openrouter/...;groq/...
